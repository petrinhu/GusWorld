// volta.gw.card
//
// Volt-Leech (Volta): Ativa, Eletrico. Dreno termodinamico do alvo,
// devolvido a party como mana+HP. Extraida do projeto anterior (L-01) -
// conhecimento, nao codigo. Ver docs/design/mecanicas/cartas/volta.md.

#meta id volta
#meta display_name CARD_EXEC_VOLTA_NAME
#meta tier especial
#meta category ativa
#meta family eletrico
#meta base_type glifo   // //PLAYTEST: sem convenção fechada de tipo-base para especiais
#meta target_shape single
#meta charge_cost 6   // kActiveChargeCost, //PLAYTEST: mana das ativas/hibridas
#meta ap_cost 1
#meta power 0
#meta ignores_weakness_wheel false

// Leech termodinamico: ao ser usada (nao mais ao causar dano - leitura
// revogada pelo lider em 31/08/2026), drena 21% da energia do ALVO por
// uso. 55% do drenado converte e chega a party; os outros 45% se perdem
// como calor (2a lei da termodinamica). O schema deste arquivo ainda nao
// tem campo proprio para o split 55/45 nem para a escolha cronometrada
// mana-ou-vida por dificuldade; ver docs/design/mecanicas/cartas/volta.md.
@effect
trigger: OnCast
kind: Leech
percent: 21   // kVoltaDrainPercent, decisao do lider 31/08/2026: % da energia do ALVO drenada por uso (substitui o antigo kVoltaLeechPercent de 50%, que lia fracao do dano causado)

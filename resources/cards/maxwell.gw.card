// maxwell.gw.card
//
// Spectra-Wave (Maxwell): Hibrida, Eletrico, Grupo. NENHUM efeito
// declarativo — o dano-base sozinho (power + ATK do conjurador) é o efeito
// inteiro, reusando puro o caminho de área que o Newton já usa. A face
// irmã fora-de-combate ("iluminar áreas escuras") fica STUB posse-only.
// Extraida do projeto anterior (L-01). Ver
// docs/design/mecanicas/cartas/maxwell.md.

#meta id maxwell
#meta display_name CARD_EXEC_MAXWELL_NAME
#meta tier especial
#meta category hibrida
#meta family eletrico
#meta base_type glifo   // //PLAYTEST
#meta target_shape grupo
#meta mana_cost 6   // kActiveManaCost, //PLAYTEST
#meta ap_cost 1
#meta power 5   // kMaxwellPower, //PLAYTEST — decisão AUTÔNOMA do orquestrador, a confirmar; menor que o Power 8 da Tesla de propósito (não eclipsar o nicho dela)
#meta ignores_weakness_wheel false

// Sem blocos @effect: o dano-base (power acima) É o efeito inteiro. Mirar
// um aliado é no-op puro (a regra geral "fogo amigo desligado" já zera o
// dano; sem efeito declarativo, não há mais nada a rodar nesse ramo).

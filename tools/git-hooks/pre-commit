# Portao da LEI ZERO. Bloqueia commit que ACRESCENTA nome de dependencia que
# o GusWorld nao pode ligar. O GusWorld liga em GlintFx e no SO. Mais nada.
#
# Morde o DIFF, nao a arvore: divida antiga nao trava commit novo -- inclusive
# nao trava os commits que estao LIMPANDO a divida.
#
# Instalacao: python3 tools/git-hooks/install.py
# Escape consciente: LEI_ZERO_GUARD=off git commit ...
exec python3 "$(git rev-parse --show-toplevel)/tools/security/lei_zero_guard.py" --staged

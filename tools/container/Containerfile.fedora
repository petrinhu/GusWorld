#
# Image gusworld-ci-fedora (C8, slice 2): the Fedora toolchain that the CI job
# build.yml uses, built from the four-file context that context_list.sh declares.
# Nothing else from the tree enters the build context.
#
# The base is pinned by digest through BASE_IMAGE. build_image.sh passes the
# pinned reference that base_probe.sh measured, so the image and the digest
# recorded in its labels refer to the same base.
# There is no "# syntax" line on purpose: it would fetch a frontend from a registry.

ARG BASE_IMAGE=fedora:latest
FROM ${BASE_IMAGE}
ARG BASE_DIGEST=unknown
ARG BASE_VERSION_ID=unknown

# Proves that the base is the one base_probe.sh measured. A mismatch aborts the build.
RUN . /etc/os-release \
 && if [ "$VERSION_ID" != "$BASE_VERSION_ID" ]; then \
      echo "base VERSION_ID is $VERSION_ID, expected $BASE_VERSION_ID" >&2; exit 1; \
    fi

# fedora.sh sources _common.sh from its own directory and appends to GITHUB_ENV.
# Both files are copied first, so this layer is cached by their content alone.
COPY fedora.sh _common.sh /opt/gusworld-ci/
RUN mkdir -p /etc/gusworld \
 && GITHUB_ENV=/etc/gusworld/ci.env bash /opt/gusworld-ci/fedora.sh \
 && dnf clean all

# The CMake floor is a separate layer, so a change to it does not rebuild the toolchain.
COPY cmake_floor.sh /opt/gusworld-ci/
RUN mkdir -p /tmp/floor \
 && cd /tmp/floor \
 && bash /opt/gusworld-ci/cmake_floor.sh \
 && cd / \
 && rm -rf /tmp/floor

# tar and coreutils are installed explicitly, not assumed from the base image.
RUN dnf -y install tar coreutils python3-pyyaml \
 && dnf clean all

RUN useradd --create-home --uid 10001 --shell /bin/bash builder

# rpm -q exits non-zero when any package is missing, which fails the build.
RUN rpm -q tar coreutils python3-pyyaml cmake gcc-c++ ninja-build > /etc/gusworld/packages.txt \
 && cat /etc/gusworld/packages.txt

# The recipe is copied too, so the image carries the file that built it.
COPY Containerfile.fedora /opt/gusworld-ci/

LABEL org.gusworld.base.digest="${BASE_DIGEST}" \
      org.gusworld.base.version_id="${BASE_VERSION_ID}"

USER builder
WORKDIR /home/builder

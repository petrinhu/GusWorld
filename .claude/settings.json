{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/github-gossips --bus"
          },
          {
            "type": "command",
            "command": "bash $HOME/IDrive/Documentos/projetos_claudebrain/gusworld_ia_autocomm/check-inbox-hook.sh gusworld"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/github-gossips/bin/check-tunnel.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/tdd/notice.py\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
